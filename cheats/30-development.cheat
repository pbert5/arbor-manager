% nix, development

# Enter this repository's reproducible development shell
nix develop

# Run one command inside the dev shell without opening an interactive shell
nix develop --command bash -c 'command -v nixfmt && command -v navi'

# Develop AshZsh from its local checkout
nix develop --override-input ashzsh path:./packages/AshZsh

# Check Nix Arbor using the current local AshZsh; the lock file is not changed
nix flake check --override-input ashzsh path:./packages/AshZsh

# Inspect the outputs using the current local AshZsh
nix flake show --override-input ashzsh path:./packages/AshZsh

# Run the transparent local-component wrapper
nix run .#local -- overrides
nix run .#local -- check
nix run .#local -- develop

# Build or evaluate an output against the local AshZsh checkout
nix build .#<output> --override-input ashzsh path:./packages/AshZsh
nix eval .#<output> --override-input ashzsh path:./packages/AshZsh

# Develop the nested Awesome Nix Sets checkout through Ashes Tools
cd packages/AshesTools
nix flake check --override-input awesome-nix-sets path:./packages/AwesomeNixSets
cd ../..

# Apply both local child overrides through the Arbor helper
nix run .#local -- overrides
nix run .#local -- check

# Load the default shell automatically after allowing .envrc
direnv allow

# See whether direnv has loaded the current environment
direnv status

# Run the project's thin command discoverability layer
just help

# Show all variables and snippets for the repository
navi --path "$PWD/cheats"
